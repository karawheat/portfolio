---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Kara Galiere, Product Designer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-white text-neutral-900 antialiased font-[Inter]">
		<main class="min-h-[46vh] grid grid-cols-1 md:grid-cols-2">
			<!-- LEFT COLUMN: text -->
			<div class="flex flex-col justify-center px-9 md:px-16 py-16">
				<h1 class="text-lg font-medium text-neutral-500 tracking-wide uppercase mb-8">
					Kara Galiere, Product Designer
				</h1>
				<p class="font-['Instrument_Serif'] text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-tight">
					The best design should be simple. I love untangling complex experiences into thoughtful, elegant solutions.
				</p>
				<div class="mt-8">
					<a
						href="/work"
						class="inline-block border border-neutral-900 px-10 py-4 text-neutral-900 text-xs font-medium tracking-[0.2em] uppercase hover:bg-neutral-900 hover:text-white transition-colors"
					>
						Case Studies
					</a>
				</div>
			</div>

			<!-- RIGHT COLUMN: photo -->
			<div class="min-h-[320px] md:min-h-[46vh]">
				<img
    src="/kara-crop.png"
    alt="Portrait of Kara, smiling at the beach"
    class="w-full h-full object-cover object-[center_30%]"
/>
			</div>
		</main><!-- LOGO WALL -->
		<section class="border-t border-neutral-200 px-9 md:px-16 py-8">
			<h2 class="text-sm font-medium text-neutral-500 tracking-[0.2em] uppercase mb-6 text-center">
				Brands I've worked with:
			</h2>
			<div class="max-w-6xl mx-auto grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-x-12 gap-y-10 items-center justify-items-center">
				<img src="/logos/dan-murphys.png" alt="Dan Murphy's" class="max-h-10 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/bws.svg" alt="BWS" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/westpac.svg" alt="Westpac" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/st-george.svg" alt="St George" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/bom.svg" alt="Bank of Melbourne" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/toyota.svg" alt="Toyota" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/aami.svg" alt="AAMI" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/optus.png" alt="Optus" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/vodafone.svg" alt="Vodafone" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/t-mobile.svg" alt="T-Mobile" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/sainsburys.svg" alt="Sainsbury's" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/wagamama.svg" alt="Wagamama" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/australian-unity.svg" alt="Australian Unity" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
				<img src="/logos/wires.svg" alt="WIRES" class="max-h-8 w-auto grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all" />
			</div>
		</section>
	</body>
</html>