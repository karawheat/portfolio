---
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dan Murphy's — Pick-Up Nominee Change · Kara</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-neutral-900 antialiased">

    <!-- NAV -->
    <nav class="max-w-[1176px] mx-auto px-8 pt-10 pb-4">
      <a href="/work" class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors">
        ← Back
      </a>
    </nav>

    <!-- HERO -->
    <header class="max-w-[1176px] mx-auto px-8 pt-16 pb-20">
      <p class="text-sm font-medium text-neutral-500 tracking-[0.2em] uppercase mb-7">
        Case Study · 2024
      </p>
      <h1 class="font-['Instrument_Serif'] text-[64px] leading-[1.05] tracking-tight text-black mb-10" style="max-width: 1080px;">
        Dan Murphy's —<br />
        <em class="italic">Pick-Up Nominee Change</em>
      </h1>
      <div class="flex flex-wrap gap-x-16 gap-y-4 text-neutral-900">
        <div>
          <span class="block text-sm font-medium text-neutral-500 tracking-[0.2em] uppercase mb-1">Role</span>
          <span class="block text-sm text-neutral-900">UI Designer</span>
        </div>
        <div>
          <span class="block text-sm font-medium text-neutral-500 tracking-[0.2em] uppercase mb-1">Brand</span>
          <span class="block text-sm text-neutral-900">Dan Murphy's</span>
        </div>
        <div>
          <span class="block text-sm font-medium text-neutral-500 tracking-[0.2em] uppercase mb-1">Teams</span>
          <span class="block text-sm text-neutral-900">UX, Customer Hub, Fulfilment, Operations</span>
        </div>
      </div>
    </header>

    <!-- HERO IMAGE -->
    <figure class="max-w-[1176px] mx-auto px-8 mb-20">
      <img
        src="/case-studies/pickup-nominee/pickup-nominee-hero.png"
        alt="Dan Murphy's Pick-Up Nominee Change — chatbot interface"
        class="w-full h-auto"
      />
    </figure>

    <!-- OUTCOME -->
    <section class="max-w-[1176px] mx-auto px-8 mb-20">
      <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">Outcome</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-[800px] mt-6">
        <div>
          <p class="font-['Instrument_Serif'] text-5xl text-black mb-3">73.7%</p>
          <p class="text-[16px] font-light leading-[32px] text-black">Automation (solve) rate for the Pick-Up Nominee Change intent within the first 6 months</p>
        </div>
        <div>
          <p class="font-['Instrument_Serif'] text-5xl text-black mb-3">10,000+</p>
          <p class="text-[16px] font-light leading-[32px] text-black">Interactions with the broader pick-up order feature in the same period</p>
        </div>
        <div>
          <p class="font-['Instrument_Serif'] text-5xl text-black mb-3">~$80k</p>
          <p class="text-[16px] font-light leading-[32px] text-black">Estimated cost saving in the first 6 months</p>
        </div>
      </div>
    </section>

    <!-- THE DILEMMA -->
    <div class="w-full mb-20" style="background: #E7FFE5; padding: 80px 0;">
      <div class="max-w-[1176px] mx-auto px-8">
        <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">The dilemma</h2>
        <div class="text-[16px] font-light leading-[36px] text-black max-w-[800px]">
          <p class="mb-0">Dan Murphy's was transitioning customer service from a phone line to the "Murphy" chatbot. A significant gap quickly emerged: customers who'd placed pick-up orders had no way to update the designated pick-up person through digital channels.</p>
          <p>For customers and their nominees, this created real friction and inconvenience. Internally, it forced Customer Agents into manual, multi-platform workarounds — creating stress across both the contact centre and in-store staff, who couldn't release products without proper authorisation.</p>
        </div>
      </div>
    </div>

    <!-- DISCOVERY -->
    <section class="max-w-[1176px] mx-auto px-8 mb-20">
      <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">Discovery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-16 max-w-[800px] mt-6">
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Pick-Up Landscape Analysis</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Investigated the current processes and systems involved in order pick-ups to understand the full end-to-end experience.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">System Audit</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Identified all systems used for order management and customer data to understand technical constraints and integration points.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Data Analysis</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Reviewed statistics related to "Track My Delivery" intents to surface common customer queries and pain points.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Experience Review</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Analysed existing app and web experiences alongside communication channels to identify gaps in the current pick-up journey.</p>
        </div>
      </div>
    </section>

    <!-- CURRENT TEAM PAIN POINTS -->
    <section class="max-w-[1176px] mx-auto px-8 mb-20">
      <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">Current team pain points</h2>
      <p class="text-[16px] font-light leading-[36px] text-black max-w-[800px] mb-16">The UX designer facilitated a collaborative workshop with stakeholders from the Squad, Customer Hub, Fulfilment, and Operations teams. The session surfaced broad topics, underlying problems, and critical questions — and moved into generating initial ideas and discussing technical, design, experience, and product considerations.</p>
      <img
        src="/case-studies/pickup-nominee/pickup-nominee-workshop.png"
        alt="Workshop and Value vs Feasibility Matrix"
        class="w-full h-auto shadow-md"
      />
    </section>

    <!-- IDEATION & DESIGN -->
    <section class="max-w-[1176px] mx-auto px-8 mb-20">
      <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">Ideation &amp; design</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-8 max-w-[800px] mt-6 mb-16">
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Ideation Session</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Ran a Crazy 8s session to rapidly generate a diverse range of solutions, pushing the team beyond obvious first ideas.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Wireframing</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Developed three distinct wireframe concepts based on the ideation outcomes, each exploring a different interaction pattern for the nominee update flow.</p>
        </div>
      </div>
      <img
        src="/case-studies/pickup-nominee/pickup-nominee-wireframes.png"
        alt="Wireframe concepts for the pick-up nominee update flow"
        class="w-full h-auto shadow-md"
      />
    </section>

    <!-- VALIDATION & REFINEMENT -->
    <section class="max-w-[1176px] mx-auto px-8 mb-20">
      <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">Validation &amp; refinement</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-8 max-w-[800px] mt-6 mb-16">
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Customer Testing</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Ran 5 rounds of customer testing via Askable across 3 scenarios. Each round fed directly into the next iteration — refining both the conversational flow and the UI.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Finalised Design</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Consolidated testing insights into a finalised conversational flow and corresponding UI, ready for developer handoff.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">Technical Feasibility</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Worked closely with the development team to ensure the proposed design aligned with existing system capabilities.</p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold leading-[36px] text-black mb-2">UI Specifications &amp; Handoff</h3>
          <p class="text-[16px] font-light leading-[32px] text-black">Created detailed UI designs and comprehensive specifications for developer handoff, with ongoing support through integration and deployment.</p>
        </div>
      </div>
      <img
        src="/case-studies/pickup-nominee/pickup-nominee-prototype.png"
        alt="Figma prototype used in customer testing"
        class="w-full h-auto shadow-md"
      />
    </section>

    <!-- RESULT -->
    <div class="w-full mb-20" style="background: #E7FFE5; padding: 80px 0;">
      <div class="max-w-[1176px] mx-auto px-8">
        <h2 class="font-['Instrument_Serif'] text-[48px] leading-[1.05] text-black mb-4">The result</h2>
        <p class="text-[16px] font-light leading-[36px] text-black max-w-[800px] mb-16">The Pick-Up Nominee Change intent launched in the Murphy chatbot and hit a 73.7% automation rate within 6 months. The broader pick-up order feature accumulated over 10,000 interactions in the same period — translating to an estimated $80,000 in cost savings.</p>
        <img
          src="/case-studies/pickup-nominee/pickup-nominee-new-ui.png"
          alt="Final UI — Pick-Up Nominee Change in the Murphy chatbot"
          class="w-full h-auto"
        />
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="max-w-[1176px] mx-auto px-8 py-24 border-t border-neutral-200">
      <a href="/work" class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors">
        ← Back to all work
      </a>
    </footer>

  </body>
</html>