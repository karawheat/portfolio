---
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Work — Kara, Product Designer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-neutral-900 antialiased">

    <!-- NAV -->
    <nav class="max-w-[1176px] mx-auto px-8 pt-10 pb-4">
      <a href="/" class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors">
        ← Kara — Product Designer
      </a>
    </nav>

    <!-- HEADER -->
    <header class="max-w-[1176px] mx-auto px-8 pt-16 pb-20">
      <h1 class="font-['Instrument_Serif'] text-[64px] leading-[1.05] tracking-tight text-black mb-6">
        Selected work
      </h1>
      <p class="text-[16px] font-light leading-[36px] text-neutral-600 max-w-[600px]">
        A selection of product design case studies spanning retail, finance, and telecommunications.
      </p>
    </header>

    <!-- CASE STUDY LIST -->
    <section class="max-w-[1176px] mx-auto px-8 pb-32">

      <!-- CASE STUDY 1 -->
      <a href="/work/endeavour-retail-media" class="group block border-t border-neutral-200 py-12 hover:border-neutral-900 transition-colors">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 items-start">
          <div class="w-full aspect-[4/3] bg-neutral-100 rounded-sm overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-xs font-medium text-neutral-400 tracking-[0.2em] uppercase">Thumbnail — coming soon</span>
            </div>
          </div>
          <div class="flex flex-col justify-center">
            <p class="text-xs font-medium text-neutral-500 tracking-[0.2em] uppercase mb-4">2024–2025 · Lead UI Designer</p>
            <h2 class="font-['Instrument_Serif'] leading-[1.1] text-black mb-4 group-hover:text-neutral-600 transition-colors" style="font-size: 42px;">
              Endeavour Group — <em class="italic">Retail Media Expansion</em>
            </h2>
            <p class="text-[16px] font-light leading-[32px] text-neutral-600 max-w-[560px]">
              Designed Homepage Onsite Video and Commerce Display assets for Dan Murphy's and BWS — built from the design system to keep the experience consistent, accessible, and on-brand.
            </p>
            <p class="mt-6 text-xs font-medium tracking-[0.2em] uppercase text-neutral-400 group-hover:text-neutral-900 transition-colors">View case study →</p>
          </div>
        </div>
      </a>

      <!-- CASE STUDY 2 -->
      <a href="/work/dan-murphys-pickup-nominee" class="group block border-t border-neutral-200 py-12 hover:border-neutral-900 transition-colors">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 items-start">
          <div class="w-full aspect-[4/3] bg-neutral-100 rounded-sm overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-xs font-medium text-neutral-400 tracking-[0.2em] uppercase">Thumbnail — coming soon</span>
            </div>
          </div>
          <div class="flex flex-col justify-center">
            <p class="text-xs font-medium text-neutral-500 tracking-[0.2em] uppercase mb-4">2024 · UI Designer</p>
            <h2 class="font-['Instrument_Serif'] leading-[1.1] text-black mb-4 group-hover:text-neutral-600 transition-colors" style="font-size: 42px;">
              Dan Murphy's — <em class="italic">Pick-Up Nominee Change</em>
            </h2>
            <p class="text-[16px] font-light leading-[32px] text-neutral-600 max-w-[560px]">
              Implemented a new conversational flow in the Murphy chatbot, achieving a 73.7% automation rate and ~$80k in cost savings within the first 6 months.
            </p>
            <p class="mt-6 text-xs font-medium tracking-[0.2em] uppercase text-neutral-400 group-hover:text-neutral-900 transition-colors">View case study →</p>
          </div>
        </div>
      </a>

      <!-- CASE STUDY 3 -->
      <a href="/work/bws-help-centre" class="group block border-t border-neutral-200 py-12 hover:border-neutral-900 transition-colors">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 items-start">
          <div class="w-full aspect-[4/3] bg-neutral-100 rounded-sm overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-xs font-medium text-neutral-400 tracking-[0.2em] uppercase">Thumbnail — coming soon</span>
            </div>
          </div>
          <div class="flex flex-col justify-center">
            <p class="text-xs font-medium text-neutral-500 tracking-[0.2em] uppercase mb-4">2024 · UI Designer</p>
            <h2 class="font-['Instrument_Serif'] leading-[1.1] text-black mb-4 group-hover:text-neutral-600 transition-colors" style="font-size: 42px;">
              BWS — <em class="italic">Help Centre Enhancement</em>
            </h2>
            <p class="text-[16px] font-light leading-[32px] text-neutral-600 max-w-[560px]">
              Designed a new Help Centre for the BWS app and, after an agile pivot, delivered an enhanced Contact Us page triaging customers across three support channels.
            </p>
            <p class="mt-6 text-xs font-medium tracking-[0.2em] uppercase text-neutral-400 group-hover:text-neutral-900 transition-colors">View case study →</p>
          </div>
        </div>
      </a>

      <!-- CLOSING BORDER -->
      <div class="border-t border-neutral-200"></div>

    </section>

    <!-- FOOTER -->
    <footer class="max-w-[1176px] mx-auto px-8 py-12 border-t border-neutral-200">
      <a href="/" class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors">
        ← Back to home
      </a>
    </footer>

  </body>
</html>